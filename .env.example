# Copy to .env and fill in. Real environment variables override this file.
# The backend looks for backend/.env first, then this file at the project root.

# ---------- Database ----------
# Leave DATABASE_URL unset to use a local SQLite file (default: backend/vetcare.db).
#
# PostgreSQL (Neon, Supabase, Railway, RDS, local...):
# DATABASE_URL=postgres://user:password@host:5432/vetcare?sslmode=require
#
# Explicit SQLite path:
# DATABASE_URL=sqlite://./vetcare.db
DATABASE_URL=

# Path used only when DATABASE_URL is empty.
SQLITE_PATH=vetcare.db

# ---------- Server ----------
ADDR=:8080

# Comma-separated browser origins allowed to send credentialed (cookie) requests.
# Leave empty for the normal setup, where the front end reaches /api on its own
# origin (vite proxy in dev, Render rewrite in production) and CORS never applies.
# Only fill this in if the front end is served from a different origin, and list
# exact origins — never "*", which would expose signed-in users' data to any site.
ALLOWED_ORIGINS=

# Set to true only when the front end really is on a different origin: it switches
# the session cookie to SameSite=None; Secure. Note that Firefox and Safari block
# third-party cookies regardless, so login will still fail there.
CROSS_SITE_COOKIES=

# ---------- Email reminders ----------
# With no SMTP_HOST, reminders are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vetcare.local
